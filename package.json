{
  "name": "cognilink-assistant",
  "version": "1.0.0",
  "description": "CogniLink Assistant - An Obsidian plugin for AI-enhanced knowledge management",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "deploy": "./scripts/deploy.sh",
    "clean": "rm -rf dist/ build/ coverage/",
    "validate": "npm run lint && npm test && npm run build",
    "migrate-vector-storage": "ts-node --project tsconfig.scripts.json scripts/migrate-vector-storage.ts",
    "migrate:validate": "ts-node --project tsconfig.scripts.json scripts/migrate-vector-storage.ts --validate",
    "migrate:stats": "ts-node --project tsconfig.scripts.json scripts/migrate-vector-storage.ts --stats",
    "migrate:rollback": "ts-node --project tsconfig.scripts.json scripts/migrate-vector-storage.ts --rollback",
    "test:tom-108": "jest --testPathPattern=content-post-processor",
    "test:tom-108:watch": "jest --testPathPattern=content-post-processor --watch",
    "test:tom-108:coverage": "jest --testPathPattern=content-post-processor --coverage"
  },
  "keywords": [
    "obsidian-plugin",
    "knowledge-management",
    "ai-assistant",
    "rag"
  ],
  "author": "CogniLink Team",
  "license": "MIT",
  "dependencies": {
    "@lancedb/lancedb": "^0.19.1",
    "@smithery/cli": "^1.1.79",
    "@types/uuid": "^10.0.0",
    "langchain": "^0.3.27",
    "obsidian": "^1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^13.4.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/testing-library__react": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  }
}
